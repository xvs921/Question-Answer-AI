# Copy this file to .env and fill in your own values. Never commit .env!
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/MongoDBCluster?retryWrites=true&w=majority
WOLFRAM_APP_ID=<your-wolframalpha-app-id>
# Wikipedia language code (hu, en, ...)
WIKIPEDIA_LANG=hu
# Speech recognition language (en-US, hu-HU, ...)
SPEECH_LANG=en-US
